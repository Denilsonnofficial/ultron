#!/usr/bin/env python3
"""Põe Claude Code, Codex e OpenCode (os que estiverem instalados nesta máquina) para trabalhar
em segundo plano, vários ao mesmo tempo, e fiscaliza cada trabalho.

uso:
  ultron-agentes iniciar <harness> <pasta> "<tarefa>" [--modelo M] [--esforco E] [--nome N]
        harness: claude | codex | opencode
        --esforco (claude): low|medium|high|xhigh|max    (codex: vira model_reasoning_effort)
  ultron-agentes lista                      todos os trabalhos e se ainda estão rodando
  ultron-agentes ver <id> [linhas]          fim do log (o que o agente fez/disse)
  ultron-agentes mudancas <id>              git status + diff --stat da pasta do trabalho
  ultron-agentes parar <id>                 encerra o trabalho
  ultron-agentes limpar                     esquece os trabalhos já terminados
"""
import json
import os
import shlex
import shutil
import signal
import subprocess
import sys
import time

DADOS = os.environ.get("ULTRON_DADOS", os.path.expanduser("~/.local/share/ultron/dados"))
PASTA = os.path.join(DADOS, "agentes")
LOGS = os.path.join(DADOS, "agentes-logs")


def carregar(id_):
    caminho = os.path.join(PASTA, id_ + ".json")
    if not os.path.exists(caminho):
        sys.exit(f"trabalho {id_} não existe (veja: ultron-agentes lista)")
    return json.load(open(caminho))


def salvar(t):
    os.makedirs(PASTA, exist_ok=True)
    json.dump(t, open(os.path.join(PASTA, t["id"] + ".json"), "w"), ensure_ascii=False, indent=2)


def comando_harness(h, tarefa, pasta, modelo, esforco):
    if not shutil.which(h):
        sys.exit(f"{h} não está instalado nesta máquina")
    if h == "claude":
        cmd = ["claude", "-p", tarefa, "--permission-mode", "bypassPermissions", "--output-format", "text"]
        if modelo:
            cmd += ["--model", modelo]
        if esforco:
            cmd += ["--effort", esforco]
        return cmd
    if h == "codex":
        cmd = ["codex", "exec", "--skip-git-repo-check", "-s", "danger-full-access", "-C", pasta]
        if modelo:
            cmd += ["-m", modelo]
        if esforco:
            cmd += ["-c", f"model_reasoning_effort={esforco}"]
        return cmd + [tarefa]
    if h == "opencode":
        cmd = ["opencode", "run", "--auto", "--dir", pasta]
        if modelo:
            cmd += ["-m", modelo]
        return cmd + [tarefa]
    sys.exit("harness deve ser claude, codex ou opencode")


def vivo(t):
    try:
        os.kill(int(t["pid"]), 0)
        return True
    except (ProcessLookupError, ValueError):
        return False
    except PermissionError:
        return True


def iniciar(args):
    if len(args) < 3:
        sys.exit(__doc__)
    harness, pasta, tarefa = args[:3]
    pasta = os.path.abspath(os.path.expanduser(pasta))
    opc = {"--modelo": None, "--esforco": None, "--nome": None}
    resto = args[3:]
    for i in range(0, len(resto) - 1, 2):
        if resto[i] in opc:
            opc[resto[i]] = resto[i + 1]
    id_ = (opc["--nome"] or harness) + "-" + time.strftime("%m%d-%H%M%S")
    cmd = comando_harness(harness, tarefa, pasta, opc["--modelo"], opc["--esforco"])
    os.makedirs(LOGS, exist_ok=True)
    log = os.path.join(LOGS, id_ + ".log")
    with open(log, "w") as f:
        f.write(f"=== {id_} | {harness} | {time.strftime('%d/%m %H:%M')} ===\ntarefa: {tarefa}\n\n")
    script = f"{shlex.join(cmd)}; echo; echo \"=== FIM codigo=$? ===\""
    proc = subprocess.Popen(["bash", "-lc", script], cwd=pasta, stdout=open(log, "a"), stderr=subprocess.STDOUT,
                            stdin=subprocess.DEVNULL, start_new_session=True)
    t = {"id": id_, "harness": harness, "pasta": pasta, "tarefa": tarefa, "modelo": opc["--modelo"],
         "esforco": opc["--esforco"], "pid": proc.pid, "log": log, "inicio": time.time()}
    salvar(t)
    print(f"Iniciado {id_} ({harness} em {pasta}, pid {proc.pid}). Acompanhe com: ultron-agentes ver {id_}")


def lista():
    if not os.path.isdir(PASTA) or not os.listdir(PASTA):
        print("Nenhum trabalho registrado.")
        return
    for nome in sorted(os.listdir(PASTA)):
        t = json.load(open(os.path.join(PASTA, nome)))
        mins = int((time.time() - t["inicio"]) / 60)
        print(f"{t['id']}  [{'rodando' if vivo(t) else 'terminado'}]  {t['harness']} em {t['pasta']}  há {mins} min  — {t['tarefa'][:90]}")


def ver(id_, linhas=40):
    t = carregar(id_)
    with open(t["log"], errors="replace") as f:
        conteudo = f.read().splitlines()
    print(f"[{'rodando' if vivo(t) else 'terminado'}]")
    print("\n".join(conteudo[-int(linhas):]))


def mudancas(id_):
    t = carregar(id_)
    r = subprocess.run(f"git status --short && echo --- && git diff --stat | tail -20", shell=True,
                       cwd=t["pasta"], capture_output=True, text=True)
    print((r.stdout + r.stderr).strip() or "Sem mudanças (ou a pasta não é git).")


def parar(id_):
    t = carregar(id_)
    try:
        os.killpg(int(t["pid"]), signal.SIGTERM)
    except (ProcessLookupError, PermissionError):
        pass
    print(f"Pedido de parada enviado para {id_}.")


def limpar():
    n = 0
    for nome in os.listdir(PASTA) if os.path.isdir(PASTA) else []:
        t = json.load(open(os.path.join(PASTA, nome)))
        if not vivo(t):
            os.remove(os.path.join(PASTA, nome))
            n += 1
    print(f"{n} trabalho(s) terminado(s) esquecido(s).")


if __name__ == "__main__":
    a = sys.argv[1:]
    if not a:
        sys.exit(__doc__)
    c = a[0]
    if c == "iniciar":
        iniciar(a[1:])
    elif c == "lista":
        lista()
    elif c == "ver" and len(a) > 1:
        ver(a[1], a[2] if len(a) > 2 else 40)
    elif c == "mudancas" and len(a) > 1:
        mudancas(a[1])
    elif c == "parar" and len(a) > 1:
        parar(a[1])
    elif c == "limpar":
        limpar()
    else:
        sys.exit(__doc__)
